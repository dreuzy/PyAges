<x:xmpmeta x:xmptk="Adobe XMP Core 4.2.1-c043 52.372728, 2009/01/18-15:08:04        " xmlns:x="adobe:ns:meta/">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Hydrology: Groundwater hydrology; Hydrology: Groundwater transport; Hydrology: Modeling; Hydrology: Instruments and techniques: modeling</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Constraining the age distribution of highly mixed groundwater using &lt;supscr&gt;39&lt;/supscr&gt;Ar: A multiple environmental tracer (&lt;supscr&gt;3&lt;/supscr&gt;H/&lt;supscr&gt;3&lt;/supscr&gt;He, &lt;supscr&gt;85&lt;/supscr&gt;Kr, &lt;supscr&gt;39&lt;/supscr&gt;Ar, and &lt;supscr&gt;14&lt;/supscr&gt;C) study in the semiconfined Fontainebleau Sands Aquifer (France)</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>J. A. Corcho Alvarado, R. Purtschert, F. Barbecot, C. Chabault, J. Rueedi, V. Schneider, W. Aeschbach&amp;hyphen;Hertig, R. Kipfer, H. H. Loosli</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
      <rdf:Description rdf:about="" xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
